#!/bin/sh
set -eu
code_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime="${APP_WORKBENCH_RUNTIME:-$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies}"
PATH="$runtime/node/bin:$runtime/bin/override:$runtime/bin/fallback:$PATH"
export PATH
python="${APP_WORKBENCH_PYTHON:-$runtime/python/bin/python3}"
if [ ! -x "$python" ]; then python=python3; fi
PYTHONPATH="$code_root${PYTHONPATH:+:$PYTHONPATH}"; export PYTHONPATH
exec "$python" -m appworkbench "$@"
